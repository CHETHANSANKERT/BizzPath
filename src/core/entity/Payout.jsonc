{
  "name": "Payout",
  "type": "object",
  "properties": {
    "creator_user_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "period": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "red"
      ],
      "default": "pending"
    },
    "method": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "paid_date": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.creator_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
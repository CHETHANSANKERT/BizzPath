{
  "name": "Blueprint",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "published",
        "rejected"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "red"
      ],
      "default": "draft"
    },
    "review_note": {
      "type": "string"
    },
    "setup_cost_min": {
      "type": "number"
    },
    "setup_cost_max": {
      "type": "number"
    },
    "working_capital": {
      "type": "number"
    },
    "payback_months": {
      "type": "number"
    },
    "gross_margin": {
      "type": "number"
    },
    "monthly_revenue_potential": {
      "type": "number"
    },
    "space_requirement": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "creator_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "creator_slug": {
      "type": "string"
    },
    "overview": {
      "type": "string"
    },
    "market_demand": {
      "type": "string"
    },
    "target_customer": {
      "type": "string"
    },
    "investment_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "infrastructure": {
      "type": "string"
    },
    "staff_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "salary": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "revenue_model": {
      "type": "string"
    },
    "revenue_streams": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "marketing_plan": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "expansion_strategy": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "number"
    },
    "review_count": {
      "type": "number"
    },
    "buyer_count": {
      "type": "number"
    },
    "views": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "slug",
    "category",
    "summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
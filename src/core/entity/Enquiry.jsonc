{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "blueprint-access",
        "consultation",
        "creator-application",
        "support"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple",
        "gray"
      ],
      "default": "blueprint-access"
    },
    "blueprint_id": {
      "type": "string"
    },
    "blueprint_title": {
      "type": "string"
    },
    "creator_slug": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string"
    },
    "meeting_link": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "closed"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "gray"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Creator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "expertise": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "years_experience": {
      "type": "number"
    },
    "businesses_built": {
      "type": "number"
    },
    "rating": {
      "type": "number"
    },
    "review_count": {
      "type": "number"
    },
    "consultation_fee": {
      "type": "number"
    },
    "consultation_duration": {
      "type": "number"
    },
    "response_time": {
      "type": "string"
    },
    "followers": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
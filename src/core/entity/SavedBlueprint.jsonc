{
  "name": "SavedBlueprint",
  "type": "object",
  "properties": {
    "blueprint_id": {
      "type": "string"
    },
    "blueprint_title": {
      "type": "string"
    },
    "blueprint_slug": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "blueprint_id",
    "blueprint_slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}